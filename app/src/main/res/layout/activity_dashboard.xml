<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android Code Studio"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#3F51B5"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your Ideas, Anywhere"
            android:textSize="16sp"
            android:textColor="#757575"
            android:layout_marginBottom="32dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="4"
            android:verticalSpacing="16dp"
            android:horizontalSpacing="16dp">

            <Button
                android:id="@+id/btnCreateProject"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Create project"
                android:drawableTop="@android:drawable/ic_menu_add"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />

            <Button
                android:id="@+id/btnOpenProject"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Open existing project"
                android:drawableTop="@android:drawable/ic_menu_edit"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />

            <Button
                android:id="@+id/btnCloneRepo"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Clone git repository"
                android:drawableTop="@android:drawable/ic_menu_rotate"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />

            <Button
                android:id="@+id/btnTerminal"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Terminal"
                android:drawableTop="@android:drawable/ic_menu_sort_by_size"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />

            <Button
                android:id="@+id/btnGetStarted"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Get started"
                android:drawableTop="@android:drawable/ic_menu_save"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />

            <Button
                android:id="@+id/btnPreferences"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Preferences"
                android:drawableTop="@android:drawable/ic_menu_preferences"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />

            <Button
                android:id="@+id/btnIdeConfig"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="IDE Configurations"
                android:drawableTop="@android:drawable/ic_menu_manage"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />

            <Button
                android:id="@+id/btnDocumentation"
                style="@style/Widget.AppCompat.Button.Colored"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:text="Documentation"
                android:drawableTop="@android:drawable/ic_menu_info_details"
                android:gravity="center"
                android:padding="16dp"
                android:background="@drawable/dashboard_button_bg" />
        </GridLayout>

    </LinearLayout>
</ScrollView>
